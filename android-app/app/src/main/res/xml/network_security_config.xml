<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Force HTTPS for everything; cleartext (http://) blocked everywhere. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
